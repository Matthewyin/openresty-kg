# 非敏感部署参数；必须显式使用 --env-file，不自动读取项目模型 .env。
PI_IMAGE=pi-knowledge:verified
PI_BASE_PATH=/pi/
PI_PORT=51808
PI_NETWORK=gemini-net
# 模型环境文件：只含 API 密钥（GLM_API_KEY），以只读文件挂载到容器。
PI_MODEL_ENV_FILE=/absolute/path/to/model.env
# 模型配置目录（绝对路径）：目录内需有 configuration.json（模型 id、上下文窗口、输出上限、思考级别、baseUrl）。
# 以只读“目录”挂载到容器 /run/config；修改 configuration.json 后刷新页面即生效，无需重建容器。
# 例外：baseUrl 若换成另一台主机，需重建容器（出站白名单按启动时的主机固定）。
PI_MODEL_CONFIG_DIR=/absolute/path/to/config
# 联网参考开关（true/false），默认关闭。
PI_WEB_SEARCH=false
